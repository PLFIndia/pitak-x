<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The build joins this file with the manifest of every plugin and
         library into ONE "merged" manifest, and that one ships. A `tools:`
         attribute below is an instruction to that merger; it is not part
         of the app. -->
    <!-- Biometric vault unlock (#34 B2, opt-in / default OFF). Gates release of
         a hardware-stored key only; no other use. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <!-- Barcode/ISBN scanning (#29). Requested just-in-time on the scan screen;
         not required to use the app (manual entry always works). -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- A camera is OPTIONAL. A store hides an app from every device that
         lacks a feature the app requires, and it reads a feature as
         required unless a line says otherwise. Three lines:
         - `camera` and `camera.autofocus`: Android's reference of
           <uses-feature> says Google Play takes both as required from the
           CAMERA permission alone. (For autofocus the build tools show no
           such reading; the line follows the reference.)
         - `camera.any`: the camera plugin (camera_android_camerax) declares
           it as required. When two manifests disagree about `required`,
           the merger takes "true", so a plain line here changes nothing
           (tried 2026-11-18: the merged file said "true"). `tools:replace`
           tells it to take THIS file's value. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false"/>
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false"
        tools:replace="android:required"/>
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false"/>
    <!-- REMOVED from the merged manifest (`tools:node="remove"`): three
         permissions the camera plugin declares for things Pitak never does.
         The two scanners only show the camera's picture and read it, without
         sound; a cover photo is taken by the phone's own camera app. Nothing
         in the app ever asked the user for one of the three, so no install
         ever held them: they only made the list of permissions say more
         than PRIVACY.md does.
         - RECORD_AUDIO: for video with sound. It also made a microphone a
           required feature.
         - WRITE_EXTERNAL_STORAGE: for saving a capture to shared storage on
           Android 9 and older.
         - READ_EXTERNAL_STORAGE: no manifest names it. The build tools add
           it because the plugin asks for the one before, and they go on
           adding it after that one is removed (tried 2026-11-18), so it
           needs a rule of its own. The plugin's README gives this rule. -->
    <uses-permission
        android:name="android.permission.RECORD_AUDIO"
        tools:node="remove"/>
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:node="remove"/>
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:node="remove"/>
    <!-- Internet for ISBN metadata lookup (#30) and reading other libraries'
         published sites. Used on explicit user action AND, when the user
         leaves "Event alerts" on (default ON, Settings), by a scheduled
         background check of the libraries they saved — roughly every 12 h,
         HTTPS only, no credentials (PRIVACY.md, ADR 0024). -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Background event alerts (ADR 0024). Android 13+ runtime permission,
         requested only after an in-app explanation. flutter_local_notifications
         also merges VIBRATE from its own manifest; declared here explicitly so
         the app's permission set is readable in one place. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <!-- Merged by androidx.work (via the workmanager plugin), NOT declared
         here: ACCESS_NETWORK_STATE (the "connected" job constraint),
         RECEIVE_BOOT_COMPLETED (re-arm the periodic job after reboot),
         WAKE_LOCK (keep the CPU on for the few seconds a check runs) and
         FOREGROUND_SERVICE (unused by Pitak; the library declares it for
         expedited work).
         EVERY permission of the merged manifest is listed, with where it
         comes from, in android/merged-permissions.txt. CI holds the merged
         manifest of both flavors to that list on every pull request
         (tool/check_merged_manifest.py), so a plugin update cannot add a
         permission unseen. The merged files themselves are under
         build/app/intermediates/merged_manifests/<variant>/. -->
    <!-- Privacy: Android Auto Backup defaults ON and would silently copy the
         catalogue DB (private notes, shelf locations), preferences (contact
         details) and covers to the user's Google account — contradicting the
         "your data stays on your device" promise in PRIVACY.md. The app ships
         its own explicit, user-initiated .pitabak backup instead. Both flags
         are needed: allowBackup disables cloud backup; dataExtractionRules
         (explicit excludes for every domain, see res/xml) also disables the
         API 31+ device-to-device transfer that allowBackup alone may not. -->
    <application
        android:label="Pitak"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- image_cropper: uCrop's crop screen, shown after a cover photo is
             taken on the book-detail screen. Required by the plugin; without it
             the crop step crashes at runtime. -->
        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar"/>
        <!-- REMOVED from the merged manifest: an entry of image_picker_android
             (a service, switched off) whose only purpose is to make Google
             Play services install a photo picker module on Android 12 and
             older. Pitak does not use that picker (the plugin's
             `useAndroidPhotoPicker` stays off), so the entry asked for
             something the app never needs. For both flavors. -->
        <service
            android:name="com.google.android.gms.metadata.ModuleDependencies"
            tools:node="remove"/>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Lets url_launcher resolve a browser for opening saved library
             bookmarks (https) on Android 11+ package-visibility. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <!-- Borrower contact actions: dialer (tel) + email (mailto). WhatsApp
             uses an https wa.me link, covered by the VIEW/https intent above. -->
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO"/>
            <data android:scheme="mailto"/>
        </intent>
    </queries>
</manifest>
